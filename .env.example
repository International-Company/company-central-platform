# ============================================================================
# Company Central Platform — environment variable template
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is gitignored. NEVER put a real secret in THIS file — it is committed.
#
# Staging and production take these values from the cloud secret manager,
# not from a file (ARCHITECTURE.md §12.7).
# ============================================================================

# --- Runtime -----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml. Local development only.
CCP_ConnectionStrings__Platform=Host=localhost;Port=5432;Database=ccp_platform;Username=ccp_dev;Password=ccp_dev_local_only

# --- Object storage (Documents module, ADR-014) ------------------------------
CCP_Storage__Endpoint=http://localhost:9000
CCP_Storage__AccessKey=ccp_dev
CCP_Storage__SecretKey=ccp_dev_local_only
CCP_Storage__Bucket=ccp-documents

# --- Mail (development catcher) ----------------------------------------------
CCP_Mail__Host=localhost
CCP_Mail__Port=1025
CCP_Mail__From=noreply@platform.local

# --- Authentication (ADR-006) ------------------------------------------------
# PLACEHOLDER ONLY. Generate a real local key pair in Phase 2; never commit one.
CCP_Jwt__Issuer=https://platform.local
CCP_Jwt__Audience=ccp-api
CCP_Jwt__SigningKeyPath=REPLACE_WITH_LOCAL_PATH_NOT_COMMITTED

# --- Two-factor authentication (Phase 5, ARCHITECTURE.md §12.5) --------------
# A PATH, never a key. The file holds a base64-encoded 256-bit key and comes
# from the secret manager or a mounted secret; it must never enter the
# repository. Generate one locally with:
#
#   openssl rand -base64 32 > ~/.ccp/mfa.key
#
# Outside Development the Platform refuses to start without it, deliberately:
# a generated key would change on every deployment and make every enrolled
# second factor unusable.
CCP_Security__MfaProtection__KeyPath=REPLACE_WITH_LOCAL_PATH_NOT_COMMITTED

# --- Deploying to a managed platform (Railway, Fly, Render, ...) --------------
# Those platforms publish a single DATABASE_URL as a URI. Npgsql cannot parse
# that form, so the Platform translates it. CCP_ConnectionStrings__Platform
# still wins if you set it.
#
# They also offer no mounted files, so keys may be given as values instead of
# paths. A path is strictly better - it keeps key material out of the process
# environment - and remains preferred wherever files exist. See
# docs/security/secrets-management.md.
#
#   CCP_Database__ApplyMigrationsOnStartup=true
#   CCP_Identity__SigningKey=<base64 of the PEM private key>
#   CCP_Security__MfaProtection__Key=<base64 of a 256-bit key>
#
# Generate them with:
#   openssl genrsa 3072 | base64 -w0
#   openssl rand -base64 32
#
# And to create the first administrator, once, then remove these:
#   CCP_Identity__Bootstrap__Enabled=true
#   CCP_Identity__Bootstrap__Username=admin
#   CCP_Identity__Bootstrap__Email=admin@yourcompany.com
#   CCP_Identity__Bootstrap__DisplayName=Administrator
#   CCP_Identity__Bootstrap__InitialPassword=<a long one-time passphrase>

# --- Rate limits (per minute, per partition) ----------------------------------
# Defaults shown. Raise Authentication if a whole office shares one public
# address - see docs/security/rate-limiting.md section 3.
# CCP_RateLimits__Authentication=10
# CCP_RateLimits__Anonymous=60
# CCP_RateLimits__Write=120
# CCP_RateLimits__Read=600

# --- Frontend (Phase 7) ------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Company Central Platform
CCP_API_BASE_URL=http://localhost:5080
