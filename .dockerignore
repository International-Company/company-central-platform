# Keep the build context small and, more importantly, keep local secrets and
# build output out of the image entirely.
**/bin/
**/obj/
**/.vs/
**/node_modules/
**/.next/
.git/
.github/
docs/
tests/
# The frontend source is part of the context because its image is built from
# the repository root, like the API's. Its build output and dependencies are
# not - they are large, reproducible, and belong in neither image.
frontend/.next/
frontend/node_modules/
.env
.env.*
!.env.example
*.md
.data/
docker-compose.yml
