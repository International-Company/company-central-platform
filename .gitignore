# ============================================================================
# Company Central Platform — .gitignore
#
# Written BEFORE the first commit, deliberately (ARCHITECTURE.md P8).
# A .gitignore added after a secret has been committed does not help:
# git history is permanent. If a secret ever reaches a commit, the secret
# must be rotated — removing it from history is not sufficient.
# ============================================================================

# ----------------------------------------------------------------------------
# SECRETS — never commit any of these
# ----------------------------------------------------------------------------
*.env
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer
secrets.json
appsettings.Local.json
appsettings.*.Local.json
**/secrets/
*.secrets.*

# ----------------------------------------------------------------------------
# .NET
# ----------------------------------------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Bb]uild/
[Bb]uilds/
artifacts/

# ...but /build at the repository root is ours, not MSBuild's. It holds the
# Dockerfile. The rule above is aimed at compiler output, which lives in bin/
# and obj/, and it silently swallowed a directory we author: the image build
# failed in CI with "lstat build: no such file or directory" because the
# Dockerfile had never been committed at all.
!/build/
!/build/**
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
project.lock.json
project.fragment.lock.json
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.dbmdl
*.jfm
*.publishsettings
PublishScripts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.binlog

# Test results and coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
TestResults/
.coverlet/

# ----------------------------------------------------------------------------
# Node / Next.js (frontend/)
# ----------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
playwright-report/
test-results/
blob-report/
.playwright/

# ----------------------------------------------------------------------------
# Local development data — never commit database or storage volumes
# ----------------------------------------------------------------------------
.data/
docker/volumes/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
logs/
*.log

# ----------------------------------------------------------------------------
# OS / editor noise
# ----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.idea/
*.iml

# ----------------------------------------------------------------------------
# Temporary
# ----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# --- Frontend ---------------------------------------------------------------
# Build output and dependencies. `frontend/.next` is generated on every build
# and `node_modules` is reproducible from the lockfile.
frontend/.next/
frontend/node_modules/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# Screenshots written by e2e/gallery.spec.ts and uploaded by CI
frontend/e2e-gallery/
