<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Contracts only. The email channel goes through the governed door like
      every other outbound call: the allow-list and the shared call log. SMTP is
      not HTTP, so it cannot use the connector, but the allow-list is a
      question about a host name and the call log is a row, and neither cares
      what happens on the socket afterwards.
    -->
    <ProjectReference Include="..\..\Integrations\CCP.Modules.Integrations.Contracts\CCP.Modules.Integrations.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Kernel\CCP.Kernel\CCP.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Kernel\CCP.Kernel.Application\CCP.Kernel.Application.csproj" />
    <ProjectReference Include="..\..\..\Kernel\CCP.Kernel.Infrastructure\CCP.Kernel.Infrastructure.csproj" />
    <ProjectReference Include="..\CCP.Modules.Notifications.Domain\CCP.Modules.Notifications.Domain.csproj" />
    <ProjectReference Include="..\CCP.Modules.Notifications.Application\CCP.Modules.Notifications.Application.csproj" />
    <ProjectReference Include="..\CCP.Modules.Notifications.Contracts\CCP.Modules.Notifications.Contracts.csproj" />

    <!--
      Identity's public surface, and nothing more. Contracts only: no reference
      to another module's Domain, Application or Infrastructure exists in this
      module, which is what keeps it extractable.
    -->
    <ProjectReference Include="..\..\Identity\CCP.Modules.Identity.Contracts\CCP.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Security\CCP.Modules.Security.Contracts\CCP.Modules.Security.Contracts.csproj" />
    <ProjectReference Include="..\..\Workflow\CCP.Modules.Workflow.Contracts\CCP.Modules.Workflow.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
