<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Contracts only. Breached-password screening reaches a third party on the
      public internet, and every outbound call passes one door: it asks the
      gateway to approve the host and records the attempt, the same way SMTP
      does. HTTPS to a fixed well-known endpoint cannot use the integration
      connector, which is shaped around registered providers and their
      endpoints.
    -->
    <ProjectReference Include="..\..\Integrations\CCP.Modules.Integrations.Contracts\CCP.Modules.Integrations.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Kernel\CCP.Kernel\CCP.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Kernel\CCP.Kernel.Application\CCP.Kernel.Application.csproj" />
    <ProjectReference Include="..\..\..\Kernel\CCP.Kernel.Infrastructure\CCP.Kernel.Infrastructure.csproj" />
    <ProjectReference Include="..\CCP.Modules.Identity.Domain\CCP.Modules.Identity.Domain.csproj" />
    <ProjectReference Include="..\CCP.Modules.Identity.Application\CCP.Modules.Identity.Application.csproj" />
    <ProjectReference Include="..\CCP.Modules.Identity.Contracts\CCP.Modules.Identity.Contracts.csproj" />

    <!--
      Contracts only, and only here. Identity needs to know where the person
      behind an account sits in order to scope a user list, and a user account
      has no department of its own. The application layer declares the question
      (IUserPlacement) and never learns which module answers it.
    -->
    <ProjectReference Include="..\..\Organization\CCP.Modules.Organization.Contracts\CCP.Modules.Organization.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
