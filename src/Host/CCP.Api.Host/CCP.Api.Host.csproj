      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Emit the OpenAPI document as part of the build, into a file the frontend
      generates its types from.

      Written to the repository rather than to obj/ on purpose: the document is
      a contract, and a contract that only exists inside a build output cannot
      be reviewed in a pull request. A change to it should be as visible as a
      change to any other file.
    -->
    <!--
      Off by default, and turned on explicitly by the step that regenerates the
      contract:

        dotnet build src/Host/CCP.Api.Host -p:GenerateApiContract=true

      The generator starts the application to read its endpoints, and the
      composition root refuses to start without a connection string - it has no
      way to know it is being asked for a document rather than for service. So
      generation needs one supplied, and making every ordinary `dotnet build`
      depend on an ambient environment variable would be a trap for anyone who
      cloned the repository and typed the obvious command.
    -->
    <GenerateApiContract Condition="'$(GenerateApiContract)' == ''">false</GenerateApiContract>
    <OpenApiGenerateDocuments>$(GenerateApiContract)</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>$(GenerateApiContract)</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../../contracts</OpenApiDocumentsDirectory>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
