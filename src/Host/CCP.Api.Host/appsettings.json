{
  "Platform": {
    "BaseUrl": "http://localhost:5080",
    "AllowedOrigins": [],
    "DefaultLocale": "en",
    "SupportedLocales": [ "en", "ar" ]
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 8,
    "BaseRetryDelay": "00:00:10",
    "MaxRetryDelay": "00:10:00"
  },
  "Security": {
    "TotpIssuer": "Company Central Platform",
    "RecoveryCodeCount": 10,
    "RecoveryCodeLowWaterMark": 3,
    "StepUpValidity": "00:15:00",
    "MfaProtection": {
      "KeyPath": null
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
