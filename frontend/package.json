{
  "name": "ccp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:types": "openapi-typescript ../contracts/platform-api.json -o src/types/platform-api.ts",
    "verify:types": "npm run generate:types && git diff --exit-code src/types/platform-api.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.5.25",
    "next-intl": "^4.14.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.36.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "^5.0.1"
  }
}
